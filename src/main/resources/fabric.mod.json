{
	"schemaVersion": 1,
	"id": "serverpresence",
	"version": "${version}",
	"name": "Server Presence",
	"description": "Affiche le serveur Minecraft (logo, nom, IP) dans la présence Discord, se masque quand tu es en vanish. Réglages : touche F7 ou /presence.",
	"authors": [
		"Draft_fr"
	],
	"contact": {
		"sources": "https://github.com/draft-yt-gaming/ServerPresence"
	},
	"license": "CC0-1.0",
	"icon": "assets/serverpresence/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"fr.draftfr.serverpresence.ServerPresenceClient"
		]
	},
	"mixins": [
		"serverpresence.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
